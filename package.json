{
  "name": "pdfgil",
  "version": "1.0.0",
  "description": "Offline PDF Merger, Splitter, Rotator, and Compressor using CitruSS UI Kit",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electronmon .",
    "build": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "pdf",
    "editor",
    "merge",
    "split",
    "rotate",
    "compress",
    "electron"
  ],
  "author": "Trunçgil",
  "license": "ISC",
  "dependencies": {
    "pdf-lib": "*"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "com.truncgil.pdfgil",
    "productName": "PDFgil",
    "copyright": "Copyright © 2026 Trunçgil",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFgil"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
